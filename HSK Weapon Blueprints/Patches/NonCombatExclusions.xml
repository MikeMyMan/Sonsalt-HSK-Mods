      <xpath>Defs/ThingDef[defName="CE_FlareGun"]</xpath>
      <value><li Class="WeaponBlueprints.WBS_GatingOverride"><mode>Never</mode></li></value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
