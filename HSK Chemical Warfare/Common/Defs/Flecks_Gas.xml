<?xml version="1.0" encoding="utf-8"?>
<!-- Puffs and glints for gas clouds. Tinted per gas at spawn (instanceColor), so one set serves every gas. -->
<Defs>

  <!-- Thrown outward when gas is released: traps, grenades, shells, canisters, vents. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>PGR_GasPuff</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.12</fadeInTime>
    <solidTime>0.9</solidTime>
    <fadeOutTime>2.4</fadeOutTime>
    <growthRate>0.55</growthRate>
  </FleckDef>

  <!-- Slow drift over a standing cloud. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>PGR_GasWisp</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>1.1</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>2.2</fadeOutTime>
    <growthRate>0.12</growthRate>
  </FleckDef>

  <!-- Sparkle for nanite swarms and crystalline barbs. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>PGR_GasGlint</defName>
    <graphicData>
      <texPath>Things/Mote/SparkFlash</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.12</solidTime>
    <fadeOutTime>0.45</fadeOutTime>
  </FleckDef>

</Defs>
