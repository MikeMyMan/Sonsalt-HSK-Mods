<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.6 build of the same source (..\HSKTacticalAI): dotnet build -c Release   (output goes to ..\..\1.6\Assemblies)
       Compiles against the Krafs.Rimworld.Ref 1.6 reference package, so it builds whichever game version is installed. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HSKTacticalAI</AssemblyName>
    <RootNamespace>HSKTacticalAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RW16</DefineConstants>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <Version>0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HSKTacticalAI\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
