<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Generated by tools\Build-ResearchGates.ps1 (edit the table there, not this file).
       Research gates for buildings that HSK 1.7 / addons leave without any research, so they were available from
       day one in the zero-research scenarios. Each def: replace researchPrerequisites if the node exists (HSK uses
       IsNull="True" on the workbench), otherwise add it; skipped if the def is absent.
       Reasoning per building: README.md -->

  <!-- spike trap (HSK deadfall: medieval components, mechanism, wire) - same tier as sandbags / reinforced ditch -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="TrapSpike"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="TrapSpike"]/researchPrerequisites</xpath>
      <value><researchPrerequisites><li>Fortification_B1</li></researchPrerequisites></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="TrapSpike"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="TrapSpike"]</xpath>
        <value><researchPrerequisites><li>Fortification_B1</li></researchPrerequisites></value>
      </match>
    </nomatch>
  </Operation>

  <!-- bullets autoloader - first turrets using its calibers are M240B / M2 Browning (Heavy turrets I; implies Electronics II for its parts) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Turret_Autoloader_Bullets"]/researchPrerequisites</xpath>
