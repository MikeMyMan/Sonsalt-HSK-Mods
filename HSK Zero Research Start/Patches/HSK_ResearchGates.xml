      <value><researchPrerequisites><li>SniperTurret</li></researchPrerequisites></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="Turret_Autoloader_Bullets"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Turret_Autoloader_Bullets"]</xpath>
        <value><researchPrerequisites><li>SniperTurret</li></researchPrerequisites></value>
      </match>
    </nomatch>
  </Operation>

