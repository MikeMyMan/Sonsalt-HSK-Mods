    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]</xpath><value><costList><SandResource>6</SandResource></costList></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="FT_WallSandbag"]/statBases/MaxHitPoints</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]/statBases/MaxHitPoints</xpath><value><MaxHitPoints>400</MaxHitPoints></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]/statBases</xpath><value><MaxHitPoints>400</MaxHitPoints></value></nomatch>
