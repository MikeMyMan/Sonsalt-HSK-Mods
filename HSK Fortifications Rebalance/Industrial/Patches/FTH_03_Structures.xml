<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Sandbag wall: full-height, impassable sandbag wall. HSK sandbags = 300 HP low cover, 5 fabric + 3 sand, Fortification_B1 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="FT_WallSandbag"]/label</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]/label</xpath><value><label>sandbag wall</label></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]</xpath><value><label>sandbag wall</label></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="FT_WallSandbag"]/description</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]/description</xpath><value><description>Sandbags stacked shoulder-high and held by steel rods into a full wall. Blocks movement and line of fire, does not hold a roof. Cheap, quick and ugly; it soaks up small-arms fire well but crumbles under explosives.</description></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]</xpath><value><description>Sandbags stacked shoulder-high and held by steel rods into a full wall. Blocks movement and line of fire, does not hold a roof. Cheap, quick and ugly; it soaks up small-arms fire well but crumbles under explosives.</description></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="FT_SandBag_Base"]/stuffCategories</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[@Name="FT_SandBag_Base"]/stuffCategories</xpath><value><stuffCategories><li>Fabric</li><li>Leathery</li></stuffCategories></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[@Name="FT_SandBag_Base"]</xpath><value><stuffCategories><li>Fabric</li><li>Leathery</li></stuffCategories></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="FT_WallSandbag"]/costStuffCount</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]/costStuffCount</xpath><value><costStuffCount>8</costStuffCount></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="FT_WallSandbag"]</xpath><value><costStuffCount>8</costStuffCount></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
